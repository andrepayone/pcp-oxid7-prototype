{% extends 'page/checkout/payment.html.twig' %}

{% block change_payment %}
    <script src="{{ oView.pcpGetHostedTokenizationScriptUrl() }}" integrity="sha384-En0FTt1/y/oAtSiKcVajUNbL3xKFS6znYv+TGUO6wtMrD8d//NlUJRCVA7PT44Ua" crossorigin="anonymous"></script>

    {% if oView.isPcpPayment() %}
        {{ script({ include: "js/widgets/oxpayment.min.js", priority: 10, dynamic: __oxid_include_dynamic }) }}
        {{ script({ include: "js/libs/jqBootstrapValidation.min.js", priority: 10, dynamic: __oxid_include_dynamic }) }}
        {{ script({ add: "$( '#payment' ).oxPayment();", dynamic: __oxid_include_dynamic }) }}
        {{ script({ add: "$('input,select,textarea').not('[type=submit]').jqBootstrapValidation();", dynamic: __oxid_include_dynamic }) }}

        <form action="{{ oViewConf.getSslSelfLink() }}" class="form-horizontal js-oxValidate payment" id="payment" name="order" method="post" novalidate="novalidate">
            <div class="hidden">
                {{ oViewConf.getHiddenSid()|raw }}
                {{ oViewConf.getNavFormParams()|raw }}
                <input type="hidden" name="cl" value="{{ oViewConf.getActiveClassName() }}">
                <input type="hidden" name="fnc" value="validatepayment">
                <input type="hidden" id="pcp_creditcard_token" name="dynvalue[pcp_creditcard_token]" value="">
                <input type="hidden" id="pcp_creditcard_cardtype" name="dynvalue[pcp_creditcard_cardtype]" value="">
                <input type="hidden" id="pcp_creditcard_product_id" name="dynvalue[pcp_creditcard_product_id]" value="">
                <input type="hidden" id="pcp_creditcard_holder" name="dynvalue[pcp_creditcard_holder]" value="">
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h3 id="paymentHeader" class="card-title">{{ translate({ ident: "PCP_MERCHANT_REFERENCE" }) }}</h3>
                </div>
                <div class="card-body">
                    {% set pcpMerchantReference = oView.pcpGetMerchantReference() %}
                    {% set pcpCheckoutReference = oView.pcpGetCheckoutReference() %}
                    <div class="mb-3 row">
                        <label class="req col-form-label col-lg-4">{{ translate({ ident: "PCP_MERCHANT_REFERENCE" }) }}:</label>
                        <div class="col-lg-8">
                            <input type="text" class="form-control" size="20" maxlength="20" name="dynvalue[pcp_merchant_reference]" value="{{ pcpMerchantReference }}">
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="req col-form-label col-lg-4">{{ translate({ ident: "PCP_CHECKOUT_REFERENCE" }) }}:</label>
                        <div class="col-lg-8">
                            <input type="text" class="form-control" size="20" maxlength="20" name="dynvalue[pcp_checkout_reference]" value="{{ pcpCheckoutReference }}">
                        </div>
                    </div>
                </div>
            </div>

            {% if oView.getPaymentList() %}
                <div class="card mb-3">
                    <div class="card-header">
                        <h3 id="paymentHeader" class="card-title">{{ translate({ ident: "PAYMENT_METHOD" }) }}</h3>
                    </div>
                    <div class="card-body">
                        {% set inptcounter = -1 %}
                        {% for sPaymentID, paymentmethod in oView.getPaymentList() %}
                            {% set inptcounter = inptcounter + 1 %}
                            {% block select_payment %}
                                <div class="card card-body mb-2">
                                    {% if sPaymentID == "pcpcreditcard" %}
                                        <div class="payment-option">
                                            <div class="payment-option-form">
                                                <input class="form-check-input" id="payment_{{ sPaymentID }}" type="radio" name="paymentid"
                                                       value="{{ sPaymentID }}"{% if oView.getCheckedPaymentId() == paymentmethod.oxpayments__oxid.value %} checked{% endif %}>
                                                <label class="form-check-label"
                                                       for="payment_{{ sPaymentID }}">{{ paymentmethod.oxpayments__oxdesc.value }}</label>
                                                <div class="payment-option-info{% if oView.getCheckedPaymentId() == paymentmethod.oxpayments__oxid.value %} activePayment{% endif %}">
                                                    <div class="pcp-payment-content">
                                                        <div>
                                                            <img
                                                                    src="{{ oViewConf.getModuleUrl('PayonePcpPrototype', 'img/visa_logo.png') }}"
                                                                    alt="{{ translate({ ident: "PCP_DEMO_CREDITCARD" }) }}"
                                                                    style="max-width: 200px;margin-bottom: 20px;"
                                                            >
                                                        </div>
                                                        <div id="payment-IFrame"></div>
                                                        <div id="pcp_cc_error" class="alert alert-danger d-none mt-2"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% elseif sPaymentID == "pcpsecuredebit" %}
                                        <div class="payment-option">
                                            <div class="payment-option-form">
                                                <input class="form-check-input" id="payment_{{ sPaymentID }}" type="radio" name="paymentid"
                                                       value="{{ sPaymentID }}"{% if oView.getCheckedPaymentId() == paymentmethod.oxpayments__oxid.value %} checked{% endif %}>
                                                <label class="form-check-label"
                                                       for="payment_{{ sPaymentID }}">{{ paymentmethod.oxpayments__oxdesc.value }}</label>
                                                <div class="payment-option-info{% if oView.getCheckedPaymentId() == paymentmethod.oxpayments__oxid.value %} activePayment{% endif %}">
                                                    <div class="pcp-payment-content">
                                                        <div>
                                                            <img
                                                                    src="{{ oViewConf.getModuleUrl('PayonePcpPrototype', 'img/Zahlungsmethode_Lastschrift.png') }}"
                                                                    alt="Direct Debit"
                                                                    style="max-width: 200px;margin-bottom: 20px;"
                                                            >
                                                        </div>

                                                        <div class="form-floating mb-3">
                                                            <input id="{{ sPaymentID }}_iban" placeholder="{{ translate({ ident: 'PCP_DEMO_IBAN' }) }}" autocomplete="off" type="text" class="form-control" size="20" maxlength="64" name="dynvalue[pcp_demo_iban]" value="DE52940594210000082271" disabled>
                                                            <label for="{{ sPaymentID }}_iban">{{ translate({ ident: "PCP_DEMO_IBAN" }) }}</label>
                                                        </div>
                                                        <div class="form-floating mb-3">
                                                            <input id="{{ sPaymentID }}_accountholder" placeholder="{{ translate({ ident: 'PCP_DEBIT_ACCOUNTHOLDER' }) }}" autocomplete="off" type="text" class="form-control" size="20" maxlength="64" name="dynvalue[pcp_demo_accountholder]" value="{{ oView.pcpGetCardHolder() }}" disabled>
                                                            <label for="{{ sPaymentID }}_accountholder">{{ translate({ ident: "PCP_DEBIT_ACCOUNTHOLDER" }) }}</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% elseif sPaymentID == "pcppaypal" %}
                                        <div class="payment-option">
                                            <div class="payment-option-form">
                                                <input class="form-check-input" id="payment_{{ sPaymentID }}" type="radio" name="paymentid"
                                                       value="{{ sPaymentID }}"{% if oView.getCheckedPaymentId() == paymentmethod.oxpayments__oxid.value %} checked{% endif %}>
                                                <label class="form-check-label"
                                                       for="payment_{{ sPaymentID }}">{{ paymentmethod.oxpayments__oxdesc.value }}</label>
                                                <div class="payment-option-info{% if oView.getCheckedPaymentId() == paymentmethod.oxpayments__oxid.value %} activePayment{% endif %}">
                                                    <div class="pcp-payment-content">
                                                        <img
                                                                src="{{ oViewConf.getModuleUrl('PayonePcpPrototype', 'img/paypal.png') }}"
                                                                alt="PayPal"
                                                                style="max-width: 200px;margin-bottom: 20px;"
                                                        >
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% elseif sPaymentID == "pcpsecureinstallment" %}
                                        <div class="payment-option">
                                            <div class="payment-option-form">
                                                <input class="form-check-input" id="payment_{{ sPaymentID }}" type="radio" name="paymentid"
                                                       value="{{ sPaymentID }}"{% if oView.getCheckedPaymentId() == paymentmethod.oxpayments__oxid.value %} checked{% endif %}>
                                                <label class="form-check-label"
                                                       for="payment_{{ sPaymentID }}">{{ paymentmethod.oxpayments__oxdesc.value }}</label>
                                                <div class="payment-option-info{% if oView.getCheckedPaymentId() == paymentmethod.oxpayments__oxid.value %} activePayment{% endif %}">
                                                    <div class="pcp-payment-content">
                                                        <div>
                                                            <img
                                                                    src="{{ oViewConf.getModuleUrl('PayonePcpPrototype', 'img/zahlungsmethode_ratenkauf.png') }}"
                                                                    alt="{{ translate({ ident: "PCP_MESSAGE_INSTALLMENT_PAYMENT" }) }}"
                                                                    style="max-width: 200px;margin-bottom: 20px;"
                                                            >
                                                        </div>
                                                        <div class="desc">
                                                            <i>{{ translate({ ident: "PCP_MESSAGE_INSTALLMENT_PAYMENT" }) }}</i>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% elseif sPaymentID == "pcppayinstore" %}
                                        <div class="payment-option">
                                            <div class="payment-option-form">
                                                <input class="form-check-input" id="payment_{{ sPaymentID }}" type="radio" name="paymentid"
                                                       value="{{ sPaymentID }}"{% if oView.getCheckedPaymentId() == paymentmethod.oxpayments__oxid.value %} checked{% endif %}>
                                                <label class="form-check-label"
                                                       for="payment_{{ sPaymentID }}">{{ paymentmethod.oxpayments__oxdesc.value }}</label>
                                                <div class="payment-option-info{% if oView.getCheckedPaymentId() == paymentmethod.oxpayments__oxid.value %} activePayment{% endif %}">
                                                    <div class="pcp-payment-content">
                                                        <div>
                                                            <img
                                                                    src="{{ oViewConf.getModuleUrl('PayonePcpPrototype', 'img/pick_up_in_store.png') }}"
                                                                    alt="{{ translate({ ident: "PCP_MESSAGE_PAY_IN_STORE_PAYMENT" }) }}"
                                                            >
                                                        </div>
                                                        <div class="desc">
                                                            <i>{{ translate({ ident: "PCP_MESSAGE_PAY_IN_STORE_PAYMENT" }) }}</i>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% else %}
                                        {{ parent() }}
                                    {% endif %}
                                </div>
                            {% endblock %}
                        {% endfor %}
                    </div>
                </div>

                {% block checkout_payment_nextstep %}
                    {% if oView.isLowOrderPrice() %}
                        <div class="alert alert-info">
                            <b>{{ translate({ ident: "MIN_ORDER_PRICE" }) }} {{ oView.getMinOrderPrice() }} {{ currency.sign }}</b>
                        </div>
                    {% else %}
                        <div class="d-flex justify-content-between">
                            <a href="{{ oViewConf.getBasketLink() }}" class="btn btn-outline-secondary" id="paymentBackStepBottom">
                                <i class="bi bi-arrow-left"></i> {{ translate({ ident: "PREVIOUS_STEP" }) }}
                            </a>
                            <button type="submit" name="userform" class="btn btn-primary" id="paymentNextStepBottom">
                                {{ translate({ ident: "CONTINUE_TO_NEXT_STEP" }) }} <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    {% endif %}
                {% endblock %}
            {% endif %}
        </form>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var pcpJwt = '{{ oView.pcpGetJwtToken() }}';
                var sdkInitialized = false;

                if (!pcpJwt) {
                    var errEl = document.getElementById('pcp_cc_error');
                    if (errEl) {
                        errEl.textContent = 'Token-Fehler: Authentication-Token konnte nicht geladen werden.';
                        errEl.classList.remove('d-none');
                    }
                    return;
                }

                var pcpConfig = {
                    iframe: {
                        iframeWrapperId: "payment-IFrame",
                        height: 350,
                        width: "100%",
                        zIndex: 9998
                    },
                    locale: "{{ oViewConf.getActiveLangAbbr() == 'de' ? 'de_DE' : 'en_GB' }}",
                    token: pcpJwt,
                    email: "",
                    showCardholderName: true,
                    strictCardholderName: false,
                    isSecurityCodeMasked: true,
                    allowedCardSchemes: ["amex", "mastercard", "visa", "diners"]
                };

                function initPcpIframe() {
                    if (sdkInitialized) return;
                    var wrapper = document.getElementById('payment-IFrame');
                    if (!wrapper || wrapper.offsetParent === null) return;

                    if (window.HostedTokenizationSdk) {
                        window.HostedTokenizationSdk.init().then(function() {
                            window.HostedTokenizationSdk.getPaymentPage(pcpConfig);
                            sdkInitialized = true;
                        }).catch(function(err) {
                            var errContainer = document.getElementById('pcp_cc_error');
                            if (errContainer) {
                                errContainer.textContent = 'SDK Init-Fehler';
                                errContainer.classList.remove('d-none');
                            }
                        });
                    }
                }

                var ccRadio = document.getElementById('payment_pcpcreditcard');
                if (ccRadio) {
                    if (ccRadio.checked) {
                        initPcpIframe();
                    }
                    document.querySelectorAll('input[name="paymentid"]').forEach(function(radio) {
                        radio.addEventListener('change', function() {
                            if (ccRadio.checked) {
                                setTimeout(initPcpIframe, 50);
                            }
                        });
                    });
                }

                var paymentForm = document.getElementById('payment');
                if (paymentForm) {
                    paymentForm.addEventListener('submit', function(event) {
                        var selectedPayment = document.querySelector('input[name="paymentid"]:checked');
                        var tokenInput = document.getElementById('pcp_creditcard_token');

                        if (selectedPayment && selectedPayment.value === 'pcpcreditcard') {
                            if (tokenInput && tokenInput.value !== '') {
                                return true;
                            }

                            event.preventDefault();
                            event.stopPropagation();

                            var errorContainer = document.getElementById('pcp_cc_error');
                            if (errorContainer) {
                                errorContainer.classList.add('d-none');
                            }

                            if (!window.HostedTokenizationSdk || !sdkInitialized) {
                                if (errorContainer) {
                                    errorContainer.textContent = 'Kreditkartenformular nicht geladen.';
                                    errorContainer.classList.remove('d-none');
                                }
                                return;
                            }

                            window.HostedTokenizationSdk.submitForm(
                                function(statusCode, token, cardDetails) {
                                    tokenInput.value = token;
                                    if (cardDetails) {
                                        if (cardDetails.cardholderName) {
                                            document.getElementById('pcp_creditcard_holder').value = cardDetails.cardholderName;
                                        }
                                        if (cardDetails.cardType) {
                                            document.getElementById('pcp_creditcard_cardtype').value = cardDetails.cardType;
                                            var schemes = { visa: 1, amex: 2, mastercard: 3, diners: 132 };
                                            var mappedId = schemes[cardDetails.cardType.toLowerCase()] || 1;
                                            document.getElementById('pcp_creditcard_product_id').value = mappedId;
                                        }
                                    }
                                    paymentForm.submit();
                                },
                                function(statusCode, errorResponse) {
                                    if (errorContainer) {
                                        errorContainer.textContent = errorResponse && errorResponse.error
                                            ? errorResponse.error
                                            : 'Validierungsfehler (' + statusCode + ')';
                                        errorContainer.classList.remove('d-none');
                                    }
                                }
                            );
                        }
                    });
                }
            });
        </script>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}